{
  "name": "pple-design-systems",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-toolchain.ts",
    "check:manifest": "node scripts/check-publish-manifest.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "test": "bun run --filter @pplethai/components test",
    "build": "bun run --filter @pplethai/components build && bun run --filter docs build",
    "dev": "bun run --filter @pplethai/components build && bun run --filter docs dev",
    "check": "node scripts/check-publish-manifest.ts && oxfmt --check && oxlint && tsc -b && bun run test && bun run build",
    "changeset": "changeset",
    "ci:publish": "bun run --filter @pplethai/components build && changeset publish",
    "version-packages": "changeset version && bun install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "24.19.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
